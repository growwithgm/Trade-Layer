# Shopify App Credentials (from Partners Dashboard)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_APP_URL=https://your-tunnel-url.ngrok.io

# Scopes required by the app (comma-separated)
SHOPIFY_API_SCOPES=read_products,write_products,read_orders

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/shopify_app

# Server
PORT=3001
NODE_ENV=development

# Host for App Bridge (same as SHOPIFY_APP_URL, without trailing slash)
HOST=https://your-tunnel-url.ngrok.io
