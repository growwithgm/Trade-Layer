{% comment %}
  TradeLayer B2B Pricing Block
  Passes shop/customer/product data to tradelayer.js via data attributes.
  JS fetches live pricing from the TradeLayer backend and renders the result.
{% endcomment %}

{{ 'tradelayer.css' | asset_url | stylesheet_tag }}

{% assign tl_login_required   = block.settings.login_based_pricing %}
{% assign tl_hide_price_msg   = block.settings.hide_price_message | default: 'Login to see wholesale prices' %}
{% assign tl_original_price   = product.selected_or_first_available_variant.price %}

<div
  id="tradelayer-root"
  class="tradelayer-wrapper"
  data-shop-domain="{{ shop.domain }}"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-original-price="{{ tl_original_price }}"
  data-currency="{{ cart.currency.symbol }}"
  data-login-required="{{ tl_login_required }}"
  data-login-url="{{ routes.account_login_url }}"
  data-hide-price-message="{{ tl_hide_price_msg | escape }}"
  data-customer-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-customer-id="{% if customer %}{{ customer.id }}{% endif %}"
>
  {% comment %}Server-side fallback — replaced by JS once it boots{% endcomment %}
  {% if customer == blank and tl_login_required %}
    <div class="tradelayer-login-prompt">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" style="color:#008060" aria-hidden="true">
        <path d="M10 0C4.477 0 0 4.477 0 10s4.477 10 10 10 10-4.477 10-10S15.523 0 10 0zm0 4a3 3 0 110 6 3 3 0 010-6zm0 14a8 8 0 01-6.27-3.034C4.427 13.337 7.027 12 10 12s5.573 1.337 6.27 2.966A8 8 0 0110 18z"/>
      </svg>
      <span>{{ tl_hide_price_msg }} &mdash; <a href="{{ routes.account_login_url }}">Log in</a></span>
    </div>
  {% elsif customer %}
    <div class="tradelayer-loading">Loading your price&hellip;</div>
  {% endif %}
</div>

<div id="tradelayer-qty-notices" class="tradelayer-rules" style="display:none"></div>
<div id="tradelayer-qty-error" class="tradelayer-qty-error"></div>

<script src="{{ 'tradelayer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "TradeLayer B2B Pricing",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "login_based_pricing",
      "label": "Require login to see wholesale prices",
      "default": false,
      "info": "When enabled, guests will see a login prompt instead of their price."
    },
    {
      "type": "text",
      "id": "hide_price_message",
      "label": "Message shown to guests",
      "default": "Login to see wholesale prices",
      "info": "Shown when 'Require login' is enabled and the visitor is not logged in."
    }
  ]
}
{% endschema %}
