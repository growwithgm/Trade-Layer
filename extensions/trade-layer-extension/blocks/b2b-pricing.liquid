{% comment %}
  TradeLayer B2B Pricing Block
  Target: product pages (section block)

  This block:
  1. Checks if customer is logged in
  2. If login-based pricing is enforced and customer is a guest, shows a login prompt
  3. If customer is logged in, renders the JS-powered price display
  4. Injects quantity rule data (from storefront API via metafields or fallback)
  5. Loads tradelayer.js to handle dynamic pricing + quantity enforcement
{% endcomment %}

{{ 'tradelayer.css' | asset_url | stylesheet_tag }}

{% assign tl_customer_id = '' %}
{% if customer %}
  {% assign tl_customer_id = customer.id | prepend: 'gid://shopify/Customer/' %}
{% endif %}

{% assign tl_product_id = product.id | prepend: 'gid://shopify/Product/' %}
{% assign tl_variant_id = product.selected_or_first_available_variant.id | prepend: 'gid://shopify/ProductVariant/' %}
{% assign tl_original_price = product.selected_or_first_available_variant.price %}
{% assign tl_login_required = block.settings.login_based_pricing %}
{% assign tl_hide_price_message = block.settings.hide_price_message | default: 'Login to see wholesale prices' %}

{% comment %} Check quantity rules stored in product metafields (set by the app) {% endcomment %}
{% assign tl_qty_min  = product.metafields.tradelayer.min_quantity | default: 1 %}
{% assign tl_qty_step = product.metafields.tradelayer.step_quantity | default: 1 %}
{% assign tl_qty_max  = product.metafields.tradelayer.max_quantity %}

<div
  id="tradelayer-root"
  class="tradelayer-wrapper"
  data-shop-domain="{{ shop.domain }}"
  data-customer-id="{{ tl_customer_id }}"
  data-product-id="{{ tl_product_id }}"
  data-variant-id="{{ tl_variant_id }}"
  data-original-price="{{ tl_original_price }}"
  data-login-url="{{ routes.account_login_url }}"
  data-currency="{{ cart.currency.symbol }}"
  data-login-required="{{ tl_login_required }}"
  data-qty-min="{{ tl_qty_min }}"
  data-qty-step="{{ tl_qty_step }}"
  {% if tl_qty_max %}data-qty-max="{{ tl_qty_max }}"{% endif %}
>
  {% comment %}
    Server-side rendering for non-JS browsers and initial page load.
    tradelayer.js will replace this content once it initialises.
  {% endcomment %}
  {% if customer == blank and tl_login_required %}
    <div class="tradelayer-login-prompt">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" style="color:#008060" aria-hidden="true">
        <path d="M10 0C4.477 0 0 4.477 0 10s4.477 10 10 10 10-4.477 10-10S15.523 0 10 0zm0 4a3 3 0 110 6 3 3 0 010-6zm0 14a8 8 0 01-6.27-3.034C4.427 13.337 7.027 12 10 12s5.573 1.337 6.27 2.966A8 8 0 0110 18z"/>
      </svg>
      <span>{{ tl_hide_price_message }} &mdash; <a href="{{ routes.account_login_url }}">{{ 'Log in' }}</a></span>
    </div>
  {% elsif customer %}
    <div class="tradelayer-loading">Loading your price&hellip;</div>
  {% endif %}
</div>

{% comment %} Quantity rule notices (server-rendered for speed) {% endcomment %}
{% if customer %}
  {% if tl_qty_min > 1 or tl_qty_step > 1 or tl_qty_max %}
    <div class="tradelayer-rules" id="tradelayer-qty-notices">
      {% if tl_qty_min > 1 %}
        <div class="tradelayer-notice">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 0C4.477 0 0 4.477 0 10s4.477 10 10 10 10-4.477 10-10S15.523 0 10 0zm1 15H9v-2h2v2zm0-4H9V5h2v6z"/></svg>
          Minimum order: <strong>{{ tl_qty_min }}</strong> units
        </div>
      {% endif %}
      {% if tl_qty_step > 1 %}
        <div class="tradelayer-notice">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 0C4.477 0 0 4.477 0 10s4.477 10 10 10 10-4.477 10-10S15.523 0 10 0zm1 15H9v-2h2v2zm0-4H9V5h2v6z"/></svg>
          Must be ordered in multiples of <strong>{{ tl_qty_step }}</strong>
        </div>
      {% endif %}
      {% if tl_qty_max %}
        <div class="tradelayer-notice">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 0C4.477 0 0 4.477 0 10s4.477 10 10 10 10-4.477 10-10S15.523 0 10 0zm1 15H9v-2h2v2zm0-4H9V5h2v6z"/></svg>
          Maximum order: <strong>{{ tl_qty_max }}</strong> units
        </div>
      {% endif %}
    </div>
    <div class="tradelayer-qty-error" id="tradelayer-qty-error"></div>
  {% endif %}
{% endif %}

<script src="{{ 'tradelayer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "TradeLayer B2B Pricing",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "login_based_pricing",
      "label": "Require login to see wholesale prices",
      "default": false,
      "info": "When enabled, guests will see a login prompt instead of prices."
    },
    {
      "type": "text",
      "id": "hide_price_message",
      "label": "Message shown to guests",
      "default": "Login to see wholesale prices",
      "info": "Shown when 'Require login' is enabled and the visitor is not logged in."
    }
  ]
}
{% endschema %}
